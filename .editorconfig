root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

# Generated by `petsitter man`: editors must leave them byte for byte.
[man/*.1]
trim_trailing_whitespace = false

[*.{toml,yml,yaml,md}]
indent_style = space
indent_size = 2
